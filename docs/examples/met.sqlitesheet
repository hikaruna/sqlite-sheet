  {
   "type": "table",
   "name": "作者"
  },
  {
   "type": "table",
   "name": "部門"
  },
  {
   "type": "table",
   "name": "時代"
  },
  {
   "type": "table",
   "name": "素材"
  },
  {
   "type": "table",
   "name": "タグ"
  },
  {
   "type": "table",
   "name": "作品_作者"
  },
  {
   "type": "table",
   "name": "作品_素材"
  },
  {
   "type": "table",
   "name": "作品_タグ"
  },
  {
   "type": "query",
   "name": "時代の階層",
   "sql": "SELECT e.名前 AS 時代, c.名前 AS 世紀, c.開始年, c.終了年, count(w.作品ID) AS 作品数\nFROM 時代 c\nJOIN 時代 e ON e.時代ID = c.上位時代ID\nLEFT JOIN 作品 w ON w.時代ID = c.時代ID\nGROUP BY c.時代ID\nORDER BY c.開始年"
  },
  {
   "type": "query",
   "name": "作者別の作品数",
   "sql": "SELECT a.名前, a.国籍, a.生年, a.没年, count(*) AS 作品数, group_concat(DISTINCT wa.役割) AS 役割\nFROM 作者 a\nJOIN 作品_作者 wa USING (作者ID)\nGROUP BY a.作者ID\nORDER BY 作品数 DESC, a.名前"
  },
  {
   "type": "query",
   "name": "素材ごとの作品",
   "sql": "SELECT m.名前 AS 素材, count(*) AS 作品数, group_concat(w.題名, ' / ') AS 作品\nFROM 素材 m\nJOIN 作品_素材 USING (素材ID)\nJOIN 作品 w USING (作品ID)\nGROUP BY m.素材ID\nORDER BY 作品数 DESC"
  },
  {
   "type": "query",
   "name": "同じタグの作品の組",
   "sql": "SELECT t.名前 AS タグ, w1.題名 AS 作品1, w2.題名 AS 作品2\nFROM 作品_タグ x\nJOIN 作品_タグ y ON y.タグID = x.タグID AND y.作品ID > x.作品ID\nJOIN タグ t ON t.タグID = x.タグID\nJOIN 作品 w1 ON w1.作品ID = x.作品ID\nJOIN 作品 w2 ON w2.作品ID = y.作品ID\nORDER BY t.名前"
  }
 ]
}
